# Copia este archivo como .env y ajusta los valores
APP_PORT=19821
BACKEND_PORT=19820

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
# Origen(es) desde donde se accede al admin (con esquema y puerto)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:19821,http://127.0.0.1:19821,http://localhost:19820,http://127.0.0.1:19820

# Superusuario inicial (se crea solo si no existe)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=cambia-esta-clave

# 1 = cargar licores de ejemplo al iniciar
SEED_DATA=1
